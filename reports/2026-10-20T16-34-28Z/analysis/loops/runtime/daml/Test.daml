module Test where

import Daml.Script
import DA.Assert
import DA.List (sort)
import B21ReturnInCreateLoop
import B22ReturnInInnerLoop (first_positive)
import qualified B23PassInLoop as B23

giveUntil : [Party] -> Party -> Script [Party]
giveUntil owners stop = do
  issuer <- allocateParty "issuer"
  cid <- submit issuer do createCmd Iou with issuer, owner = issuer, amount = 1.0
  submit issuer do exerciseCmd cid GiveUntil with owners, stop
  ious <- query @Iou issuer
  pure (sort [i.owner | (_, i) <- ious, i.owner /= issuer])

control_every_owner_gets_an_iou : Script ()
control_every_owner_gets_an_iou = do
  alice <- allocateParty "alice"
  bob <- allocateParty "bob"
  stop <- allocateParty "stop"
  given <- giveUntil [alice, bob] stop
  given === sort [alice, bob]

return_stops_the_loop : Script ()
return_stops_the_loop = do
  alice <- allocateParty "alice"
  stop <- allocateParty "stop"
  bob <- allocateParty "bob"
  given <- giveUntil [alice, stop, bob] stop
  given === [alice]

control_no_positive_gives_0 : Script ()
control_no_positive_gives_0 = do
  first_positive [[0, -1], [-2]] === 0

return_in_inner_loop_gives_the_first_positive : Script ()
return_in_inner_loop_gives_the_first_positive = do
  first_positive [[0, -1], [3, 4]] === 3

control_positive_numbers_pass : Script ()
control_positive_numbers_pass = do
  owner <- allocateParty "owner"
  cid <- submit owner do createCmd B23.Iou with issuer = owner, owner, amount = 1.0
  submit owner do exerciseCmd cid B23.Check with xs = [1.0, 2.0]

pass_keeps_the_assert : Script ()
pass_keeps_the_assert = do
  owner <- allocateParty "owner"
  cid <- submit owner do createCmd B23.Iou with issuer = owner, owner, amount = 1.0
  submitMustFail owner do exerciseCmd cid B23.Check with xs = [1.0, -1.0]
