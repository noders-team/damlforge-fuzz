module LoopMany where

template Iou
  with
    issuer : Party
    owner : Party
    amount : Decimal
  where
    signatory [issuer]
    observer [owner]

    nonconsuming choice Many : [ContractId Iou]
      with
        owners : [Party]
      controller owner
      do
        let self = this
        let (cids : [ContractId Iou]) = []
        _damlforge_cids3 <-
          foldlA
            (\cids o -> do
              if o /= self.owner
                then do
                  _damlforge_cids_item1 <- create (Iou with issuer = self.issuer, owner = o, amount = self.amount)
                  let _damlforge_cids2 = cids <> [_damlforge_cids_item1]
                  pure _damlforge_cids2
                else do
                  pure cids)
            cids owners
        pure (_damlforge_cids3)
