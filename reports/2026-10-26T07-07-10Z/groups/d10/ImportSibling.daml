module ImportSibling where

import Models (Kind(..), Lot(..), Note(..), double)

template Desk
  with
    issuer : Party
    owner : Party
  where
    signatory [issuer]
    observer [owner]

    nonconsuming choice Issue : ContractId Note
      with
        amount : Decimal
      controller issuer
      do
        let self = this
        let lot = Lot with kind = CASH, amount = double amount
        create (Note with issuer = self.issuer, owner = self.owner, lot = lot)

    nonconsuming choice Size : Decimal
      with
        cid : ContractId Note
      controller owner
      do
        let self = this
        note <- fetch cid
        pure ((note.lot).range 0 3)
