module Models where

data Lot = Lot
  with
    kind : Kind
    amount : Decimal
  deriving (Eq, Show)

data Kind = CASH | BOND
  deriving (Eq, Show)

Int : Decimal -> Decimal
Int x =
  x + x

template Note
  with
    issuer : Party
    owner : Party
    lot : Lot
  where
    signatory [issuer]
    observer [owner]
