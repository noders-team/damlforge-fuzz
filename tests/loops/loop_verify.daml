module LoopVerify where

import DA.Action (foldlA)

verify : [ContractId Iou] -> Party -> Update Decimal
verify cids p = do
  let total = (0.0 : Decimal)
  _damlforge_total2 <-
    foldlA
      (\total c -> do
        i <- fetch c
        assertMsg "issuer" (i.issuer == p)
        let _damlforge_total1 = total + i.amount
        pure _damlforge_total1)
      total cids
  pure (_damlforge_total2)

template Iou
  with
    issuer : Party
    owner : Party
    amount : Decimal
  where
    signatory [issuer]
    observer [owner]

    nonconsuming choice Sum : Decimal
      with
        cids : [ContractId Iou]
      controller owner
      do
        let self = this
        verify cids self.issuer
