module ReturnAfterNestedForInOuter where

f : [[Int]] -> Int
f groups =
  let _damlforge_maybe1 = _damlforge_loop1  groups in
  case _damlforge_maybe1 of
    Some _damlforge_early2 -> _damlforge_early2
    None ->
      0

template Iou
  with
    issuer : Party
    owner : Party
    amount : Decimal
  where
    signatory [issuer]

_damlforge_loop1 [] = None
_damlforge_loop1 (g :: _damlforge_rest) =
  Some 1
