module GettimeValue where

data EscrowTerms = EscrowTerms
  with
    amount : Decimal
    deadline : Time
  deriving (Eq, Show)

template Payout
  with
    payer : Party
    receiver : Party
    amount : Decimal
  where
    signatory [payer]
    observer [receiver]

template Escrow
  with
    buyer : Party
    seller : Party
    arbiter : Party
    terms : EscrowTerms
  where
    signatory [buyer]
    observer [seller, arbiter]
    ensure terms.amount > (0.0 : Decimal)

    choice Release : ContractId Payout
      controller arbiter
      do
        let self = this
        create (Payout with payer = self.arbiter, receiver = self.seller, amount = (self.terms).amount)

    choice Refund : ContractId Payout
      controller arbiter
      do
        let self = this
        now <- getTime
        _damlforge_effect1 <- getTime
        assertMsg "refund is allowed only after the deadline" (now > (_damlforge_effect1.terms).deadline)
        create (Payout with payer = self.arbiter, receiver = self.buyer, amount = (self.terms).amount)
