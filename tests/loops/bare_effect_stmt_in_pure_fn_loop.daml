module BareEffectStmtInPureFnLoop where

f : [ContractId Iou] -> Int
f cids =
  let n = 0 in
  let _damlforge_n2 =
        foldl
          (\n c ->
            fetch c
            let _damlforge_n1 = n + 1 in
            _damlforge_n1)
          n cids
  in
  _damlforge_n2

template Iou
  with
    issuer : Party
    owner : Party
    amount : Decimal
  where
    signatory [issuer]
