module EffectLoopWrappingReturnLoop where

import DA.Action (foldlA)

template Iou
  with
    issuer : Party
    owner : Party
    amount : Decimal
  where
    signatory [issuer]

    nonconsuming choice Find : Bool
      with
        groups : [[Party]]
      controller owner
      do
        let self = this
        _damlforge_maybe3 <- _damlforge_loop1 self groups
        case _damlforge_maybe3 of
          Some _damlforge_early4 -> pure _damlforge_early4
          None -> do
            pure (False)

_damlforge_loop2 (self : Iou) [] = pure None
_damlforge_loop2 self (o :: _damlforge_rest) = do
  if o == self.owner
    then do
      pure (Some (Some True))
    else do
      _damlforge_loop2 self _damlforge_rest

_damlforge_loop1 (self : Iou) [] = pure None
_damlforge_loop1 self (g :: _damlforge_rest) = do
  create (Iou with issuer = self.issuer, owner = self.owner, amount = self.amount)
  _damlforge_maybe1 <- _damlforge_loop2 self g
  case _damlforge_maybe1 of
    Some _damlforge_early2 -> pure _damlforge_early2
    None -> do
      _damlforge_loop1 self _damlforge_rest
