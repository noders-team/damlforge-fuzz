module EffectInAssertTest where

template Iou
  with
    issuer : Party
    owner : Party
    amount : Decimal
  where
    signatory [issuer]

    nonconsuming choice A : Bool
      with
        c : ContractId Iou
      controller owner
      do
        let self = this
        assertMsg "pos" ((fetch c).amount > (0.0 : Decimal))
        pure (True)
