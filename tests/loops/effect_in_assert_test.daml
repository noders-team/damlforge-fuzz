module EffectInAssertTest where

template Iou
  with
    issuer : Party
    owner : Party
    amount : Decimal
  where
    signatory [issuer]

    nonconsuming choice A : Bool
      with
        c : ContractId Iou
      controller owner
      do
        let self = this
        _damlforge_effect1 <- fetch c
        assertMsg "pos" (_damlforge_effect1.amount > (0.0 : Decimal))
        pure (True)
