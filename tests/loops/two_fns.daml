module TwoFns where

import DA.Action (foldlA)

has_party : [Party] -> Party -> Bool
has_party ps p =
  let _damlforge_maybe1 = _damlforge_loop1 p ps in
  case _damlforge_maybe1 of
    Some _damlforge_early2 -> _damlforge_early2
    None ->
      False

template Iou
  with
    issuer : Party
    owner : Party
    amount : Decimal
  where
    signatory [issuer]
    observer [owner]

    nonconsuming choice GiveUntil : ()
      with
        owners : [Party]
        stop : Party
      controller owner
      do
        let self = this
        _damlforge_maybe3 <- _damlforge_loop2 self stop owners
        case _damlforge_maybe3 of
          Some _damlforge_early4 -> pure _damlforge_early4
          None -> do
            pure ()

_damlforge_loop1 p [] = None
_damlforge_loop1 p (q :: _damlforge_rest) =
  if q == p
    then
      Some True
    else
      _damlforge_loop1 p _damlforge_rest

_damlforge_loop2 (self : Iou) stop [] = pure None
_damlforge_loop2 self stop (o :: _damlforge_rest) = do
  let _damlforge_cont1 = do
        create (Iou with issuer = self.issuer, owner = o, amount = self.amount)
        _damlforge_loop2 self stop _damlforge_rest
  if o == stop
    then do
      pure (Some ())
    else do
      _damlforge_cont1
