module B21ReturnInCreateLoop where

import DA.Action (foldlA)

template Iou
  with
    issuer : Party
    owner : Party
    amount : Decimal
  where
    signatory [issuer]
    observer [owner]

    nonconsuming choice GiveUntil : ()
      with
        owners : [Party]
        stop : Party
      controller issuer
      do
        let self = this
        _ <-
          foldlA
            (\() o -> do
              let _damlforge_cont1 = do
                    create (Iou with issuer = self.issuer, owner = o, amount = self.amount)
                    pure ()
              if o == stop
                then do
                  pure ()
                else do
                  _damlforge_cont1)
            () owners
        pure ()
