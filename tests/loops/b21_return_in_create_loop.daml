module B21ReturnInCreateLoop where

import DA.Action (foldlA)

template Iou
  with
    issuer : Party
    owner : Party
    amount : Decimal
  where
    signatory [issuer]
    observer [owner]

    nonconsuming choice GiveUntil : ()
      with
        owners : [Party]
        stop : Party
      controller issuer
      do
        let self = this
        _damlforge_maybe1 <- _damlforge_loop1 self stop owners
        case _damlforge_maybe1 of
          Some _damlforge_early2 -> pure _damlforge_early2
          None -> do
            pure ()

_damlforge_loop1 (self : Iou) stop [] = pure None
_damlforge_loop1 self stop (o :: _damlforge_rest) = do
  let _damlforge_cont1 = do
        create (Iou with issuer = self.issuer, owner = o, amount = self.amount)
        _damlforge_loop1 self stop _damlforge_rest
  if o == stop
    then do
      pure (Some ())
    else do
      _damlforge_cont1
