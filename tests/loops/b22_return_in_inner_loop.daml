module B22ReturnInInnerLoop where

first_positive : [[Int]] -> Int
first_positive rows =
  let _damlforge_maybe3 = _damlforge_loop1  rows in
  case _damlforge_maybe3 of
    Some _damlforge_early4 -> _damlforge_early4
    None ->
      0

template Iou
  with
    issuer : Party
    owner : Party
    amount : Decimal
  where
    signatory [issuer]
    observer [owner]

    nonconsuming choice FirstPositive : Int
      with
        rows : [[Int]]
      controller owner
      do
        let self = this
        pure (first_positive rows)

_damlforge_loop2 [] = None
_damlforge_loop2 (x :: _damlforge_rest) =
  if x > 0
    then
      Some (Some x)
    else
      _damlforge_loop2  _damlforge_rest

_damlforge_loop1 [] = None
_damlforge_loop1 (row :: _damlforge_rest) =
  let _damlforge_maybe1 = _damlforge_loop2  row in
  case _damlforge_maybe1 of
    Some _damlforge_early2 -> _damlforge_early2
    None ->
      _damlforge_loop1  _damlforge_rest
