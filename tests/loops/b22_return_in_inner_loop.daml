module B22ReturnInInnerLoop where

first_positive : [[Int]] -> Int
first_positive rows =
  0

template Iou
  with
    issuer : Party
    owner : Party
    amount : Decimal
  where
    signatory [issuer]
    observer [owner]

    nonconsuming choice FirstPositive : Int
      with
        rows : [[Int]]
      controller owner
      do
        let self = this
        pure (first_positive rows)
