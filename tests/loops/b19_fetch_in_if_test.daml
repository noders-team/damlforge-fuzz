module B19FetchInIfTest where

import DA.Action (foldlA)

template Iou
  with
    issuer : Party
    owner : Party
    amount : Decimal
  where
    signatory [issuer]
    observer [owner]

    nonconsuming choice CountLarger : Int
      with
        cids : [ContractId Iou]
      controller owner
      do
        let self = this
        let n = 0
        _damlforge_n3 <-
          foldlA
            (\n c -> do
              _damlforge_effect1 <- fetch c
              if _damlforge_effect1.amount > self.amount
                then do
                  let _damlforge_n2 = n + 1
                  pure _damlforge_n2
                else do
                  pure n)
            n cids
        pure (_damlforge_n3)
