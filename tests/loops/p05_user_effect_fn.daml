module P05UserEffectFn where

import DA.Action (foldlA)

make : Party -> Party -> Decimal -> Update (ContractId Iou)
make issuer o a = do
  create (Iou with issuer = issuer, owner = o, amount = a)

template Iou
  with
    issuer : Party
    owner : Party
    amount : Decimal
  where
    signatory [issuer]
    observer [owner]

    nonconsuming choice Many : Int
      with
        owners : [Party]
      controller owner
      do
        let self = this
        let n = 0
        _damlforge_n2 <-
          foldlA
            (\n o -> do
              make self.issuer o self.amount
              let _damlforge_n1 = n + 1
              pure _damlforge_n1)
            n owners
        pure (_damlforge_n2)
