module NestedChoice where

import DA.Action (foldlA)

template Iou
  with
    issuer : Party
    owner : Party
    amount : Decimal
  where
    signatory [issuer]
    observer [owner]

    nonconsuming choice Give : ()
      with
        groups : [[Party]]
        stop : Party
      controller owner
      do
        let self = this
        _damlforge_maybe3 <- _damlforge_loop1 self stop groups
        case _damlforge_maybe3 of
          Some _damlforge_early4 -> pure _damlforge_early4
          None -> do
            pure ()

_damlforge_loop2 (self : Iou) stop [] = pure None
_damlforge_loop2 self stop (o :: _damlforge_rest) = do
  let _damlforge_cont1 = do
        create (Iou with issuer = self.issuer, owner = o, amount = self.amount)
        _damlforge_loop2 self stop _damlforge_rest
  if o == stop
    then do
      pure (Some (Some ()))
    else do
      _damlforge_cont1

_damlforge_loop1 (self : Iou) stop [] = pure None
_damlforge_loop1 self stop (g :: _damlforge_rest) = do
  _damlforge_maybe1 <- _damlforge_loop2 self stop g
  case _damlforge_maybe1 of
    Some _damlforge_early2 -> pure _damlforge_early2
    None -> do
      _damlforge_loop1 self stop _damlforge_rest
